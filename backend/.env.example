# ─────────────────────────────────────────────────────────────────────────────
# SquadGym backend — copy to `.env` and fill in. NEVER commit the real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=8080
# Public URL of this API (used to build absolute media URLs)
API_BASE_URL=http://localhost:8080
# Comma separated list. Use * for local development.
CORS_ORIGINS=*

# ── Neon PostgreSQL ──────────────────────────────────────────────────────────
# Neon dashboard → Connect → "Pooled connection" string. Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-hex-chars
JWT_REFRESH_SECRET=replace-with-64-hex-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12

# ── First-run bootstrap (super admin) ────────────────────────────────────────
SUPER_ADMIN_EMAIL=owner@squadgym.app
SUPER_ADMIN_PASSWORD=ChangeMe-Strong-Passw0rd!
SUPER_ADMIN_NAME=Gym Owner
GYM_NAME=Squad Gym
GYM_TIMEZONE=Asia/Kolkata

# ── Object storage ───────────────────────────────────────────────────────────
# local = store on disk (development). s3 = any S3-compatible bucket
# (Neon Object Storage, AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=var/uploads
S3_ENDPOINT=https://us-east-1.aws.neon.tech
S3_REGION=us-east-1
S3_BUCKET=squadgym-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Optional CDN / public base for media (leave empty to stream through the API)
MEDIA_PUBLIC_BASE_URL=
# Signed-URL lifetime for private media
MEDIA_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=5242880

# ── Email (invitations / password reset). Leave empty to log instead. ────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Squad Gym <no-reply@squadgym.app>"

# ── Business defaults (overridable per gym in the Super Admin settings) ──────
DEFAULT_IN_GYM_WINDOW_MINUTES=60
DEFAULT_EXPIRING_SOON_DAYS=7
DEFAULT_ARCHIVE_AFTER_DAYS=90
DEFAULT_ATTENDANCE_UNDO_SECONDS=300
DEFAULT_RENEWAL_UNDO_SECONDS=300
OCCUPANCY_SNAPSHOT_INTERVAL_MINUTES=5

# ── Development helpers ──────────────────────────────────────────────────────
# When true, invitation/reset tokens are returned in the API response so you
# can test the flow without SMTP. NEVER enable in production.
EXPOSE_DEV_TOKENS=false
